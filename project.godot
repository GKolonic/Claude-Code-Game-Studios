; Engine configuration file.
; The Faithful / Divine Dominion — Godot 4.6 / GDScript / Compatibility renderer.
; Sprint 1 task 1-3 (M0 scaffold): the 10 Autoloads below are registered in
; EXACT ADR-0001 order (GameConfig first; DCS before GSM). Do not reorder.
config_version=5

[application]

config/name="The Faithful / Divine Dominion"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

GameConfig="*res://src/autoload/game_config.gd"
TraitDatabase="*res://src/autoload/trait_database.gd"
DialogueDatabase="*res://src/autoload/dialogue_database.gd"
MobileTouchFramework="*res://src/autoload/mobile_touch_framework.gd"
NPCRegistry="*res://src/autoload/npc_registry.gd"
ConversionLogicEngine="*res://src/autoload/conversion_logic_engine.gd"
DialogueConversionSystem="*res://src/autoload/dialogue_conversion_system.gd"
GameStateManager="*res://src/autoload/game_state_manager.gd"
RivalFaithSystem="*res://src/autoload/rival_faith_system.gd"
SaveLoadSystem="*res://src/autoload/save_load_system.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
